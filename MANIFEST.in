include README.md LICENSE NOTICE COMMERCIAL-LICENSING.md
include CHANGELOG.md SOURCE_SHA256SUMS
include .gitignore
recursive-include .github *.yml
recursive-include docs *.md
recursive-include examples *.py *.md *.json *.jsonl
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
global-exclude *.sqlite *.sqlite-* *.db *.db-* .DS_Store
